{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tailstory-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "tailstory.dev", "custom_domain": true },
    { "pattern": "www.tailstory.dev", "custom_domain": true }
  ],
  "previews": {}
}
